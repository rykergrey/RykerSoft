      "id": "mechameme",
      "packageName": "com.rykersoft.memegod",
      "source": "MemeGod",
      "ref": "v1.0.31",
      "env": {
        "VITE_COMMUNITY_API_URL": "https://mechameme.rykersoft.rykergrey.com"
      },
      "proxy": [
        {
          "path": "/api/",
          "upstream": "http://127.0.0.1:4186/api/",
          "maxBody": "13m",
          "readTimeout": "200s"
        }
      ],
      "proxyNote": "The existing mechameme.service (Community, free captions). Same origin, so the browser needs no CORS."
    },
    {
      "id": "guile-family",
      "packageName": "com.rykersoft.somethingsoff",
      "source": "SomethingsOff",
      "ref": "v3.3.0",
      "version": "3.3.0",
      "install": false,
      "build": null,
      "buildNote": "dist/ is committed and needs no build step."
    },
    {
      "id": "field-recorder",
      "packageName": "com.rykersoft.fieldrecorder",
      "source": "field recorder",
      "ref": "v1.1.0",
      "env": {
        "VITE_NO_SERVER": "1"
      },
      "envNote": "No transcription server is hosted. With VITE_NO_SERVER the app uses a Groq key or Pro directly, and otherwise the browser's built-in speech recognition."
    },
    {
      "id": "earbound",
      "packageName": "com.rykersoft.earbound",
      "source": "Earbound",
      "ref": "v0.11.0",
      "dir": "game",
      "env": {
        "VITE_HOSTED": "1"
      },
      "envNote": "Words the party screen for a public address: guests join with the link or code, with no shared Wi-Fi.",
      "service": {
        "entry": "server/index.ts",
        "external": [
          "vite"
        ],
        "port": 4311
      },
      "proxy": [
        {
          "path": "/party",
          "upstream": "http://127.0.0.1:4311/party",
          "websocket": true
        },
        {
          "path": "/api/",
          "upstream": "http://127.0.0.1:4311/api/"
        }
      ],
      "serviceNote": "Party rooms over a WebSocket. Rooms live in memory and end on their own; nothing is stored."
    },
    {
      "id": "close-call",
      "packageName": "com.rykersoft.closecall",
      "source": "Close-Call",
      "ref": "a767267",
      "refNote": "main at 0.4.11 with online rooms and pasted YouTube links merged in; the release has no tag.",
      "build": "npm run build:web",
      "env": {
        "VITE_SELF_HOSTED": "1"
      },
      "service": {
        "entry": "server/host.ts",
        "port": 4312,
        "env": {
          "HUB_FIREBASE_API_KEY": "AIzaSyCfDdisPZnz1qwIy_oQCOvTyk23AQdTLJA"
        }
      },
      "serviceNote": "Online rooms over a WebSocket, song lookup, YouTube link details and Pro judging. No database and no YouTube key; rooms live in memory.",
      "proxy": [
        {
          "path": "/rooms",
          "upstream": "http://127.0.0.1:4312/rooms",
          "websocket": true
        },
        {
          "path": "/api/",
          "upstream": "http://127.0.0.1:4312/api/"
        }
      ]
    }
  ]
