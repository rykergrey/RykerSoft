+/** Set when the server runs behind a proxy on the same machine, which passes the caller's address in X-Real-IP. */
+const TRUST_PROXY = process.env.TRUST_PROXY === '1';
+function callerAddress(request: import('node:http').IncomingMessage): string {
+  const forwarded = TRUST_PROXY ? request.headers['x-real-ip'] : undefined;
+  return (typeof forwarded === 'string' && forwarded.trim()) || request.socket.remoteAddress || 'unknown';
+}
+
 function rejectUpgrade(socket: import('node:stream').Duplex, status: 403 | 429 | 503): void {
