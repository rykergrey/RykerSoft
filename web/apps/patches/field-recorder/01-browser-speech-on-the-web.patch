+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { HoldSpeech, browserSpeechSupported } from './browserSpeech';
+
+type Handler = ((event: any) => void) | null;
+class FakeRecognition {
+  static last: FakeRecognition;
+  onresult: Handler = null; onerror: Handler = null; onend: Handler = null;
+  lang = ''; continuous = false; interimResults = false; maxAlternatives = 0;
+  started = false; stopped = false;
+  constructor() { FakeRecognition.last = this; }
+  start() { this.started = true; }
+  stop() { this.stopped = true; }
+  abort() { this.onend?.({}); }
+  say(...parts: [string, boolean][]) { this.onresult?.({ results: parts.map(([transcript, isFinal]) => ({ isFinal, 0: { transcript } })) }); }
+}
+
+test('reports no support where the browser has no recognizer', () => {
+  delete (globalThis as any).window;
+  assert.equal(browserSpeechSupported(), false);
+  const speech = new HoldSpeech();
+  assert.equal(speech.error, 'unsupported');
+});
+
+test('returns the words heard, including ones that land just after release', async () => {
+  (globalThis as any).window = { webkitSpeechRecognition: FakeRecognition };
+  const speech = new HoldSpeech();
+  const recognition = FakeRecognition.last;
+  assert.equal(recognition.started, true);
+  recognition.say(['sat', false]);
+  const done = speech.finish(500);
+  assert.equal(recognition.stopped, true);
+  recognition.say(['Saturn', true]);
+  recognition.onend?.({});
+  assert.equal(await done, 'Saturn');
+});
+
+test('gives up waiting after the limit and keeps what it has', async () => {
+  (globalThis as any).window = { webkitSpeechRecognition: FakeRecognition };
+  const speech = new HoldSpeech();
+  FakeRecognition.last.say(['solar', true], ['flare', false]);
+  assert.equal(await speech.finish(20), 'solar flare');
+});
