@@ -0,0 +1,80 @@
+import { Capacitor } from '@capacitor/core';
+
+/**
+ * True in the hosted web edition, which has no transcription server behind it. There, an answer
+ * without a Groq key or Pro access is heard by the browser's own speech recognition.
+ */
+export const HOSTED_WEB = import.meta.env?.VITE_NO_SERVER === '1' && !Capacitor.isNativePlatform();
+
+interface RecognitionResult { isFinal: boolean; 0?: { transcript: string } }
+interface Recognition {
+  lang: string;
+  continuous: boolean;
+  interimResults: boolean;
+  maxAlternatives: number;
+  onresult: ((event: { results: ArrayLike<RecognitionResult> }) => void) | null;
+  onerror: ((event: { error: string }) => void) | null;
+  onend: (() => void) | null;
+  start(): void;
+  stop(): void;
+  abort(): void;
+}
+
+function recognitionClass(): (new () => Recognition) | null {
+  if (typeof window === 'undefined') return null;
+  const scope = window as unknown as { SpeechRecognition?: new () => Recognition; webkitSpeechRecognition?: new () => Recognition };
+  return scope.SpeechRecognition || scope.webkitSpeechRecognition || null;
+}
+
+export const browserSpeechSupported = (): boolean => recognitionClass() !== null;
+
+/** One hold of the talk button, heard by the browser's built-in speech recognition. */
+export class HoldSpeech {
+  private recognition: Recognition | null = null;
+  private heard = '';
+  private ended = false;
+  private onEnded: (() => void) | null = null;
+  /** The browser's error code, such as "not-allowed" or "network"; empty when listening worked. */
+  public error = '';
+
+  constructor() {
+    const Recognizer = recognitionClass();
+    if (!Recognizer) { this.ended = true; this.error = 'unsupported'; return; }
+    try {
+      const recognition = new Recognizer();
+      recognition.lang = 'en-US';
+      recognition.continuous = true;
+      recognition.interimResults = true;
+      recognition.maxAlternatives = 1;
+      recognition.onresult = ({ results }) => {
+        const parts: string[] = [];
+        for (let i = 0; i < results.length; i++) parts.push(results[i][0]?.transcript?.trim() || '');
+        this.heard = parts.filter(Boolean).join(' ');
+      };
+      recognition.onerror = ({ error }) => { if (error !== 'aborted' && error !== 'no-speech') this.error = error; };
+      recognition.onend = () => { this.ended = true; this.onEnded?.(); };
+      recognition.start();
+      this.recognition = recognition;
+    } catch {
+      this.ended = true;
+      this.error = 'unavailable';
+    }
+  }
+
+  /** Stop listening and return what was heard. The last words can arrive a moment after release. */
+  public async finish(waitMs = 1200): Promise<string> {
+    if (!this.ended) {
+      await new Promise<void>((resolve) => {
+        const timeout = setTimeout(resolve, waitMs);
+        this.onEnded = () => { clearTimeout(timeout); resolve(); };
+        try { this.recognition?.stop(); } catch { clearTimeout(timeout); resolve(); }
+      });
+    }
+    return this.heard;
+  }
+
+  public cancel(): void {
+    this.ended = true;
+    try { this.recognition?.abort(); } catch { /* already stopped */ }
+  }
+}
