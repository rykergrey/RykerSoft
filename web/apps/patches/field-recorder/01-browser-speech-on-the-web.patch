+/**
+ * A browser hides microphone names until the page has permission, and most computers do not name
+ * their microphone "built-in". The hosted web edition therefore asks for permission first, prefers
+ * a microphone it can identify as built-in, and otherwise uses the browser's default one.
+ */
+async function openHostedWebMicrophone(): Promise<MediaStream> {
+  const audio = { sampleRate: { ideal: 48000 }, channelCount: 1, echoCancellation: false, noiseSuppression: false, autoGainControl: false };
+  const first = await navigator.mediaDevices.getUserMedia({ audio });
+  const input = (await navigator.mediaDevices.enumerateDevices()).find(isBuiltInInput);
+  if (!input || first.getAudioTracks()[0]?.getSettings().deviceId === input.deviceId) return first;
+  try {
+    const builtIn = await navigator.mediaDevices.getUserMedia({ audio: { ...audio, deviceId: { exact: input.deviceId } } });
+    first.getTracks().forEach((track) => track.stop());
+    return builtIn;
+  } catch {
+    return first;
+  }
+}
