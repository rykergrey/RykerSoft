# Optional unused placeholder (must be non-empty for Secrets Gradle plugin)
GEMINI_API_KEY=unused

# RykerSoft Firebase (Auth + Firestore entitlements / provider keys)
# From Firebase Console → Project settings → Your apps → Web app config
# Example: project rykersoft-abe84 (copy real values from Firebase Console / local .env)
FIREBASE_API_KEY=REPLACE_FIREBASE_API_KEY
FIREBASE_APP_ID=REPLACE_FIREBASE_APP_ID
FIREBASE_PROJECT_ID=rykersoft-abe84
FIREBASE_STORAGE_BUCKET=rykersoft-abe84.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=REPLACE_FIREBASE_MESSAGING_SENDER_ID
FIREBASE_AUTH_DOMAIN=rykersoft-abe84.firebaseapp.com
# Web OAuth 2.0 client ID used by Android Credential Manager for Google sign-in.
FIREBASE_WEB_CLIENT_ID=REPLACE_FIREBASE_WEB_CLIENT_ID
