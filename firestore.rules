rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function entitlementsPath(uid) {
      return /databases/$(database)/documents/users/$(uid)/entitlements/apps;
    }

    function hasPackageUnlock(packageId) {
      return signedIn()
        && exists(entitlementsPath(request.auth.uid))
        && get(entitlementsPath(request.auth.uid)).data.get(packageId, false) == true;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email', 'updatedAt']);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'updatedAt']);
      allow delete: if false;

      match /entitlements/apps {
        allow read: if isOwner(uid);
        // Firebase Console, Admin SDK, and trusted backend functions manage grants.
        allow create, update, delete: if false;
      }

      match /unlockRequests/{requestId} {
        // Legacy reusable-code flow is retired. Existing records remain server-only.
        allow read, write: if false;
      }
    }

    match /unlockCodes/{codeHash} {
      // Unlock codes are server-only bearer credentials.
      allow read, write: if false;
    }

    // Per-app AI provider keys (document ID = Android package name)
    match /providerKeys/{packageId} {
      allow read: if hasPackageUnlock(packageId);
      allow write: if false;
    }

    // Legacy single-doc path (unused; deny)
    match /config/providerKeys {
      allow read, write: if false;
    }
  }
}
