rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdminEmail() {
      return request.auth != null
        && request.auth.token.email == "heavensounds@gmail.com"
        && request.auth.token.email_verified == true;
    }

    function entitlementsPath(uid) {
      return /databases/$(database)/documents/users/$(uid)/entitlements/apps;
    }

    function hasPackageUnlock(packageId) {
      return signedIn()
        && exists(entitlementsPath(request.auth.uid))
        && get(entitlementsPath(request.auth.uid)).data.get(packageId, false) == true;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdminEmail();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'createdAt', 'updatedAt'])
        && request.resource.data.email == request.auth.token.email;
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'displayName', 'updatedAt'])
        && request.resource.data.email == request.auth.token.email;
      allow delete: if false;

      match /entitlements/apps {
        allow read: if isOwner(uid) || isAdminEmail();
        // Firebase Console, admin credentials, and trusted backend functions manage grants.
        allow create, update: if isAdminEmail();
        allow delete: if false;
      }

      match /unlockRequests/{requestId} {
        // Legacy reusable-code flow is retired. Existing records remain server-only.
        allow read, write: if false;
      }
    }

    match /appCapabilities/{packageId} {
      allow read: if signedIn();
      allow create, update: if isAdminEmail()
        && request.resource.data.keys().hasOnly([
          'packageName', 'displayName', 'proEnabled', 'providerModel',
          'credentialFields', 'updatedAt'
        ])
        && request.resource.data.packageName == packageId
        && request.resource.data.proEnabled is bool
        && request.resource.data.credentialFields is list;
      allow delete: if false;
    }

    match /unlockCodes/{codeHash} {
      // Unlock codes are server-only bearer credentials.
      allow read, write: if false;
    }

    // Per-app AI provider keys (document ID = Android package name)
    match /providerKeys/{packageId} {
      allow read: if isAdminEmail() || hasPackageUnlock(packageId);
      allow create, update: if isAdminEmail()
        && exists(/databases/$(database)/documents/appCapabilities/$(packageId))
        && get(/databases/$(database)/documents/appCapabilities/$(packageId)).data.proEnabled == true;
      allow delete: if false;
    }

    // Legacy single-doc path (unused; deny)
    match /config/providerKeys {
      allow read, write: if false;
    }
  }
}
